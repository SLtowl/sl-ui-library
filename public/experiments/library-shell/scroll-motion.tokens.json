    "background": { "travelRatio": { "$type": "number", "$value": 0.18 }, "scaleDelta": { "$type": "number", "$value": 0.22 } },
    "assembly": {
      "afterFirstPop": { "$type": "duration", "$value": { "value": 180, "unit": "ms" } },
      "headerStep": { "$type": "duration", "$value": { "value": 45, "unit": "ms" } },
      "categoriesAt": { "$type": "duration", "$value": { "value": 130, "unit": "ms" } },
      "categoryStep": { "$type": "duration", "$value": { "value": 22, "unit": "ms" } },
      "headingAt": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
      "cardsAt": { "$type": "duration", "$value": { "value": 270, "unit": "ms" } },
      "cardStep": { "$type": "duration", "$value": { "value": 30, "unit": "ms" } },
      "captionDelay": { "$type": "duration", "$value": { "value": 45, "unit": "ms" } },
      "inspectorAt": { "$type": "duration", "$value": { "value": 430, "unit": "ms" } },
      "distance": { "$type": "number", "$value": 8 }
    }
  }
