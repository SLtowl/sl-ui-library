{
  "motion": {
    "duration": {
      "descent": { "$type": "duration", "$value": { "value": 1250, "unit": "ms" }, "$description": "Fast descent with a smooth deceleration." },
      "return": { "$type": "duration", "$value": { "value": 950, "unit": "ms" }, "$description": "Return through the same relief scene, with a soft stop at the hero." },
      "interface": { "$type": "duration", "$value": { "value": 280, "unit": "ms" } }
    },
    "progress": {
      "titleExitEnd": { "$type": "number", "$value": 0.25 },
      "piecesStart": { "$type": "number", "$value": 0.22 },
      "backgroundFadeStart": { "$type": "number", "$value": 0.28 },
      "backgroundFadeEnd": { "$type": "number", "$value": 0.98 }
    },
    "easing": { "travel": { "$type": "string", "$value": "asymmetric-smootherstep" }, "accelerationBias": { "$type": "number", "$value": 2.25 } },
    "reveal": {
      "stagger": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
      "duration": { "$type": "duration", "$value": { "value": 320, "unit": "ms" } },
      "scaleFrom": { "$type": "number", "$value": 0.68 },
      "scalePeak": { "$type": "number", "$value": 1.045 },
      "peakAt": { "$type": "number", "$value": 0.6 },
      "opacityEnd": { "$type": "number", "$value": 0.3 }
