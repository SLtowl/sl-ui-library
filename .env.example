# Public ingestion configuration only. Never use a personal phx_ or OAuth token.
# Copy to .env.local for a local build. Pages reads the same values from repository variables.
SL_ANALYTICS_ENABLED=false
SL_ANALYTICS_PRIVACY_VERIFIED=false
SL_ANALYTICS_ENVIRONMENT=production
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_TOKEN=
POSTHOG_API_HOST=
